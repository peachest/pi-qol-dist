+/**
+ * Reconstruct the system prompt the provider actually receives from the
+ * session transcript: pi sends system messages via getSystemMessageText()
+ * (content + merged section values), and request transforms read the
+ * transcript — NOT ctx.getSystemPrompt(), which re-renders from options that
+ * may diverge from what was sent (observed: preset-filtered transcript vs
+ * unfiltered render). Sections merge last-wins, null deletes (pi semantics).
+ */
+function qcuTranscriptSystemPrompt(ctx: ExtensionCommandContext): string {
+	const sm = ctx.sessionManager as any;
+	const built = typeof sm?.buildSessionContext === "function" ? sm.buildSessionContext() : undefined;
+	const messages = Array.isArray(built?.messages) ? built.messages : [];
+	const content: string[] = [];
+	const sections = new Map<string, string>();
+	for (const message of messages) {
+		if (message?.role !== "system") continue;
+		const text = typeof message.content === "string" ? message.content : "";
+		if (text.length > 0) content.push(text);
+		for (const [name, value] of Object.entries(message.sections ?? {})) {
+			if (value === null) sections.delete(name);
+			else if (typeof value === "string") sections.set(name, value);
+		}
+	}
+	if (content.length === 0 && sections.size === 0) return "";
+	return [...content, ...sections.values()].join("\n\n");
+}
