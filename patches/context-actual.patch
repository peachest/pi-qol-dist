+/**
+ * Split pi's rendered system prompt into its named sections.
+ * Pi renders `<name>\n...\n</name>` blocks after an untagged preamble; section
+ * names match /^[a-z][a-z0-9_-]*$/ (pi system-prompt.js). Nested tags with
+ * different names (<project_instructions> inside <project_context>) stay
+ * inside their parent section.
+ */
+function qcuParsePromptSections(systemPrompt: string): Map<string, string> {
+	const sections = new Map<string, string>();
+	const re = /\n<([a-z][a-z0-9_-]*)>\n[\s\S]*?\n<\/\1>/g;
+	let match;
+	while ((match = re.exec(systemPrompt)) !== null) {
+		if (!sections.has(match[1])) sections.set(match[1], match[0].slice(1));
+	}
+	return sections;
+}
+
+/** Per-skill breakdown from the actually rendered <skills> section. */
+function qcuSkillsFromPrompt(skillsSection: string | undefined): QolContextDetailItem[] {
+	if (!skillsSection) return [];
+	const items: QolContextDetailItem[] = [];
+	const re = /\n {2}<skill>\n([\s\S]*?)\n {2}<\/skill>/g;
+	let match;
+	while ((match = re.exec(skillsSection)) !== null) {
+		const block = match[1];
+		const name = block.match(/<name>([\s\S]*?)<\/name>/)?.[1] ?? "skill";
+		const description = block.match(/<description>([\s\S]*?)<\/description>/)?.[1];
+		const location = block.match(/<location>([\s\S]*?)<\/location>/)?.[1] ?? "";
+		const group = location.includes("/.agents/") || location.includes("/.pi/") ? "user" : location ? "project" : undefined;
+		items.push({
+			description: description ? qcuOneLine(description, 120) : undefined,
+			group,
+			label: qcuOneLine(name, 90),
+			tokens: qcuEstimateTokens(match[0]),
+		});
+	}
+	return items;
+}
+
+/** Per-file breakdown from the actually rendered <project_context> section. */
+function qcuContextFilesFromPrompt(projectContext: string | undefined): QolContextDetailItem[] {
+	if (!projectContext) return [];
+	const items: QolContextDetailItem[] = [];
+	const re = /<project_instructions path="([^"]*)">\n[\s\S]*?\n<\/project_instructions>/g;
+	let match;
+	while ((match = re.exec(projectContext)) !== null) {
+		items.push({ label: qcuOneLine(match[1], 90), tokens: qcuEstimateTokens(match[0]) });
+	}
+	return items;
+}
